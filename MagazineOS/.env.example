# Environment Configuration
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secure_password
DB_NAME=magazineos
DB_LOGGING=false
DB_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API
API_PORT=3000
API_URL=http://localhost:3000

# JWT
JWT_SECRET=your-very-secure-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Frontend
VITE_API_URL=http://localhost:3000
VITE_GRAPHQL_ENDPOINT=http://localhost:3000/graphql
VITE_GRAPHQL_WS_ENDPOINT=ws://localhost:3000/graphql

# AWS/S3 (for media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=magazineos-media

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@magazineos.com

# Analytics
SEGMENT_WRITE_KEY=

# Sentry (Error tracking)
SENTRY_DSN=

# Child Safety & Compliance
COPPA_ENABLED=true
GDPR_K_ENABLED=true
CONTENT_MODERATION_THRESHOLD=0.5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Session
SESSION_SECRET=change-this-secret
SESSION_TIMEOUT=3600

# Feature Flags
FEATURE_AI_CONTENT_GENERATION=true
FEATURE_MULTILINGUAL_SUPPORT=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_WEBHOOKS=true

# Monitoring
ENABLE_HEALTH_CHECK=true
PROMETHEUS_ENABLED=false

# Development
DEBUG_MODE=false
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
